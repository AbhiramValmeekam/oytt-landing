---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../config/site.mjs';
import displayFont from '@fontsource/roboto/files/roboto-latin-900-normal.woff2?url';
import uiFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
const { title, description, noindex = false, documentPage = false } = Astro.props;
const pathname = Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(pathname, site.origin).href;
const nav = [{ href: '/#widgets', label: 'Widgets' }, { href: '/#receipts', label: 'Receipts' }, { href: '/support', label: 'Support' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!documentPage && <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OYTT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OYTT PT-03 time tracking console on white" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.origin}/og.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('oytt-theme'); } catch {}
        const theme = preference === 'dark' || preference === 'light' ? preference : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0D0D0D' : '#FFFFFF');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="wordmark" href="/" aria-label="OYTT home"><img src="/favicon.svg" width="32" height="32" alt="" /> OYTT</a>
        <nav class="desktop-nav" aria-label="Main navigation">{nav.map(link => <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle><Icon name="moon" class="moon-icon" /><Icon name="sun" class="sun-icon" /></button>
          <details class="mobile-nav"><summary class="mono">MENU <Icon name="plus" /></summary><nav aria-label="Mobile navigation">{nav.map(link => <a href={link.href}>{link.label}</a>)}<a href={site.play}>Google Play <Icon name="arrow" /></a></nav></details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copyright">© 2026 OYTT · On Your Time Too · Kompally, Hyderabad, India</p>
        <nav aria-label="Footer navigation">
          <a href="/privacy" aria-current={pathname === '/privacy' ? 'page' : undefined}>Privacy</a><span aria-hidden="true">·</span>
          <a href="/terms" aria-current={pathname === '/terms' ? 'page' : undefined}>Terms</a><span aria-hidden="true">·</span>
          <a href="/support" aria-current={pathname === '/support' ? 'page' : undefined}>Support</a><span aria-hidden="true">·</span>
          <a href="/delete-account" aria-current={pathname === '/delete-account' ? 'page' : undefined}>Delete Account</a><span aria-hidden="true">·</span>
          <a href="/children" aria-current={pathname === '/children' ? 'page' : undefined}>Children's Privacy</a>
        </nav>
        <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('[data-theme-toggle]');
      const systemTheme = matchMedia('(prefers-color-scheme: dark)');
      let explicitPreference = false;
      try { explicitPreference = ['dark', 'light'].includes(localStorage.getItem('oytt-theme')); } catch {}
      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0D0D0D' : '#FFFFFF');
        toggle?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
      };
      setTheme(document.documentElement.dataset.theme);
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        explicitPreference = true;
        setTheme(theme);
        try { localStorage.setItem('oytt-theme', theme); } catch {}
      });
      systemTheme.addEventListener('change', event => { if (!explicitPreference) setTheme(event.matches ? 'dark' : 'light'); });
      document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => document.querySelector('.mobile-nav')?.removeAttribute('open')));
    </script>
  </body>
</html>
