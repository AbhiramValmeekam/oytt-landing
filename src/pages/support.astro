---
import LegalLayout from '../layouts/LegalLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site.mjs';
const faqs = [
  ["The widget shows the wrong time or doesn't update.", 'Open the OYTT app once. It syncs with the widget. If it still looks wrong, remove the widget and add it again from your home screen.'],
  ['My time was logged automatically at 23:40.', "That's by design. At 23:40 (your phone's time), OYTT logs any running clock for you. You can still log by hand until 23:59. At midnight, a new day begins."],
  ['Only one clock runs at a time. Is that right?', 'Yes. Each task has its own clock. When you start a different task, the one that was running pauses.'],
  ['I changed phones. Will my data come back?', 'Yes. Sign in with the same Google account and your tasks, time logs and coins will sync back.'],
  ["I can't sign in.", 'Check your internet connection and make sure Google Play Services is up to date. If it still fails, email us.'],
  ['How do I earn OYTT Coins?', 'By tracking time, keeping your streak, finishing to-dos, sharing your daily receipt (once a day) and adding your first widget. Coins have no cash value and are used for rewards inside the app.'],
  ['When do rewards unlock?', "Rewards unlock after a 25-day streak. Since you're on our priority list, every deal will be first accessible to you."],
  ['How do I share my receipt?', 'Open a day → Receipt → choose WhatsApp, Share Text, PNG or PDF.'],
];
---
<LegalLayout title="Support | OYTT" heading="Support" description="Contact OYTT support and get help with widgets, time tracking, Google Sign-In, coins, receipts and account deletion.">
  <p>Need help with OYTT? We're here.</p>
  <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a><br />We usually reply within 2 working days.</p>
  <p>To help us fix your issue faster, please include:</p>
  <ul>
    <li>Your phone model and Android version</li>
    <li>The OYTT version (Settings → About)</li>
    <li>What happened, and a screenshot if possible</li>
  </ul>

  <h2>Quick help</h2>
  <div class="faq-list">
    {faqs.map(([question, answer]) => <details><summary>Q: {question}<Icon name="plus" /></summary><p>A: {answer}</p></details>)}
    <details><summary>Q: How do I delete my account?<Icon name="plus" /></summary><p>A: See <a href="/delete-account">/delete-account</a>.</p></details>
  </div>

  <h2>Report a problem or abuse</h2>
  <p>Email <a href={`mailto:${site.email}`}>{site.email}</a> with the subject "Report".</p>
  <p>OYTT, Kompally, Hyderabad, Telangana {site.postalCode}, India</p>
</LegalLayout>
